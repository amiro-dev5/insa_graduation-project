# ==============================================================================
# FixIt - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Never commit real credentials)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
!.env.example
!**/.env.example

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
backend/venv/
backend/env/
backend/.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Django Local Database, Media & Static Files
# ------------------------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
backend/db.sqlite3
backend/db.sqlite3-journal
backend/media/
backend/staticfiles/

# ------------------------------------------------------------------------------
# Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.tmp/
.npm/
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
*.bak
*.swp
*.swo

# ------------------------------------------------------------------------------
# Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
video/*.mp4